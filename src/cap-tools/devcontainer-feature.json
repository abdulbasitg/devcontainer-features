{
    "id": "cap-tools",
    "version": "2.0.0",
    "name": "cap-tools",
    "description": "SAP CAP Development Tools",
    "options": {
        "install_cds_dk": {
            "type": "boolean",
            "default": true,
            "description": "Install npm library @sap/cds-dk globally?"
        },
        "install_mbt": {
            "type": "boolean",
            "default": true,
            "description": "Install npm library mbt globally?"
        },
        "mbt_version": {
            "type": "string",
            "default": "latest",
            "description": "npm version of mbt to install"
        },
        "install_cf_cli": {
            "type": "boolean",
            "default": true,
            "description": "Install Cloud Foundry CLI?"
        },
        "cf_cli_version": {
            "type": "string",
            "default": "v8",
            "description": "Cloud Foundry CLI release tag, or v8 for the latest v8 release"
        },
        "cds_dk_version": {
            "type": "string",
            "default": "latest",
            "description": "@sap/cds-dk version to be installed"
        },
        "install_sqlite3": {
            "type": "boolean",
            "default": true,
            "description": "Install SQLite3 database?"
        },
        "install_cdsmcp": {
            "type": "boolean",
            "default": true,
            "description": "Install cds-mcp server?"
        },
        "cdsmcp_version": {
            "type": "string",
            "default": "latest",
            "description": "npm version of @cap-js/mcp-server to install"
        }
    }    
}